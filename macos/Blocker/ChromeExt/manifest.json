{
  "manifest_version": 3,
  "name": "Blocker",
  "version": "1.0",
  "description": "AI-powered anti-procrastination — block websites until you solve an academic problem or convince the judge.",
  "permissions": ["webNavigation", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blocker"
  },
  "web_accessible_resources": [
    {
      "resources": ["gatekeeper.html", "gatekeeper.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
